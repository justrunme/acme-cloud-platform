{
  "catalog": "acme-platform-tools",
  "version": "1.0.0",
  "tools": [
    {
      "name": "fs.read",
      "description": "Read a file from the agent workspace.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    {
      "name": "fs.write",
      "description": "Write a file under the agent output directory.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content_ref"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 256
          },
          "content_ref": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    {
      "name": "inventory.get",
      "description": "List Kubernetes objects of a kind in a namespace (read-only).",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "kind"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "kind": {
            "type": "string",
            "maxLength": 63
          }
        }
      }
    },
    {
      "name": "http.fetch",
      "description": "HTTP GET an allowlisted internal documentation or API URL.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    {
      "name": "kubectl.apply",
      "description": "Apply a manifest change to a Kubernetes namespace.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "resource",
          "patch",
          "environment"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "resource": {
            "type": "string",
            "maxLength": 256
          },
          "patch": {
            "type": "object"
          },
          "environment": {
            "type": "string",
            "enum": [
              "sandbox",
              "staging",
              "production"
            ]
          }
        }
      }
    },
    {
      "name": "kubectl.delete",
      "description": "Delete a Kubernetes object.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "resource"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "resource": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    {
      "name": "gitops.sync",
      "description": "Trigger a GitOps sync of an Application.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application",
          "revision"
        ],
        "properties": {
          "application": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "revision": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    {
      "name": "inference.complete",
      "description": "Request a completion from the shared inference gateway.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "max_tokens",
          "prompt_ref"
        ],
        "properties": {
          "model": {
            "type": "string",
            "maxLength": 64
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200000
          },
          "prompt_ref": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    {
      "name": "secrets.read",
      "description": "Read a Kubernetes Secret.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "name"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "name": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    }
  ]
}
